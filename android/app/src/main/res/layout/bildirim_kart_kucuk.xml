<?xml version="1.0" encoding="utf-8"?>
<!-- Skor kartı, daraltılmış: [logo] GAL  2 – 1  FEN [logo] kartın ortasında, olay (67', Bitti …) sağda
     (BildirimServisi.java). Grup tam ortada kalsın diye olay ayrı; sığmazsa olay "…" ile kısalır. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/kart_kucuk_sol_bosluk">

    <LinearLayout android:id="@+id/grup" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/ev_logo" android:layout_width="24dp" android:layout_height="24dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/ev_kisa" style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/skor" style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:textSize="18sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/dep_kisa" style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:textStyle="bold" android:maxLines="1" />
        <ImageView android:id="@+id/dep_logo" android:layout_width="24dp" android:layout_height="24dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView android:id="@+id/olay" style="@style/TextAppearance.Compat.Notification.Info"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_toEndOf="@id/grup" android:layout_alignParentEnd="true" android:layout_centerVertical="true"
        android:layout_marginStart="4dp" android:gravity="end" android:maxLines="1" android:ellipsize="end" />
</RelativeLayout>
