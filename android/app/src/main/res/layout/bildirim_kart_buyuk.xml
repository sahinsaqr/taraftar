<?xml version="1.0" encoding="utf-8"?>
<!-- Skor kartı, genişletilmiş: solda ev (logo 40dp + ad), ortada büyük skor, sağda deplasman (sütunlar üstten
     hizalı); golde altta kart genişliğinde golcü satırı, golü atan tarafa hizalı (ev solda, deplasman sağda);
     diğer olaylarda skorun altında durum yazısı (BildirimServisi.java). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp"
    android:paddingEnd="@dimen/kart_sag_bosluk">

    <TextView android:id="@+id/lig" style="@style/TextAppearance.Compat.Notification.Info"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:maxLines="1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:baselineAligned="false" android:gravity="top" android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal|top" android:orientation="vertical">
            <ImageView android:id="@+id/ev_logo" android:layout_width="40dp" android:layout_height="40dp"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/ev_ad" style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center" android:maxLines="2" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical"
            android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/skor" style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="32sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/durum" style="@style/TextAppearance.Compat.Notification.Info"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal|top" android:orientation="vertical">
            <ImageView android:id="@+id/dep_logo" android:layout_width="40dp" android:layout_height="40dp"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/dep_ad" style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center" android:maxLines="2" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- golcü satırı: "⚽ 90+4' Frankowski" + " (p)"; ad sığmazsa "…" ile kısalır (ağırlık 1 → önce o daralır),
         (p)/(k.k.) hep görünür. Biri görünür: ev_alt solda, dep_alt sağda. -->
    <FrameLayout android:id="@+id/golcu_satiri" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:visibility="gone">
        <LinearLayout android:id="@+id/ev_alt" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="start" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/ev_alt_ad" style="@style/TextAppearance.Compat.Notification.Line2"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:maxLines="1" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/ev_alt_ek" style="@style/TextAppearance.Compat.Notification.Line2"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/dep_alt" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/dep_alt_ad" style="@style/TextAppearance.Compat.Notification.Line2"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1"
                android:maxLines="1" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/dep_alt_ek" style="@style/TextAppearance.Compat.Notification.Line2"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
